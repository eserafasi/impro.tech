# Copy to .env.local and fill in. Never commit .env.local.
# Only the public anon key goes here — never the service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical site URL used for metadata, sitemap and hreflang.
NEXT_PUBLIC_SITE_URL=https://im-pro.tech
